# Sao chép thành .env.local rồi điền giá trị (Supabase → Project Settings → API).
# Để trống 2 biến NEXT_PUBLIC_* thì ứng dụng chạy chế độ demo (dữ liệu trong trình duyệt).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Chỉ dùng cho script nạp dữ liệu mẫu (npm run seed:supabase). KHÔNG khai báo trên Vercel, KHÔNG commit.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Tùy chọn: tắt đồng bộ realtime giữa các quầy lễ tân
# NEXT_PUBLIC_SUPABASE_REALTIME=off
